# Documentation values for the deployable control branch. The SML connection
# references ATSCALE_WAREHOUSE_ID; create that data warehouse in AtScale first.
ATSCALE_WAREHOUSE_ID=pg_composite_control
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=54329
POSTGRES_DATABASE=atscale_lab
POSTGRES_USER=svc_composite_control
POSTGRES_PASSWORD=svc_composite_control_local
POSTGRES_SOURCE_SCHEMA=src_b
POSTGRES_AGGREGATE_SCHEMA=agg_control

